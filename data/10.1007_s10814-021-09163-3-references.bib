@article{croix2021,
  title = {Cultures {{Without Borders}}?: {{Approaching}} the Cultural Continuum in the {{Danish}}–{{Frisian}} Coastal Areas in the Early {{Viking Age}}},
  shorttitle = {Cultures {{Without Borders}}?},
  author = {Croix, Sarah and family=IJssennagger - Van Der Pluijm, given=Nelleke, prefix=and, useprefix=true},
  date = {2021-05-27},
  journaltitle = {Scandinavian Journal of History},
  volume = {46},
  number = {3},
  pages = {304--327},
  publisher = {Routledge},
  issn = {0346-8755},
  doi = {10.1080/03468755.2019.1687332},
  url = {https://doi.org/10.1080/03468755.2019.1687332},
  urldate = {2025-05-23},
  abstract = {The research history of the Viking Age has often described the Scandinavian expansion towards the rest of early medieval Europe as involving a clash between markedly distinct cultures. These oppositions appear in written accounts contemporary to the events and have been used to stress widely common ideas about the ‘civilized’ south and the ‘barbarian’ north. In this article, we argue that these ideas focused originally on religious rather than on cultural differences and that they were constructed in connection with specific, conflictual situations. By considering the archaeological record from Frisia and Jutland, thus focusing on cultural expressions and practices in the regions presumably separated by this sharp cultural contrast, we observe a high degree of cultural similarity with local variations. Therefore, we support the previously suggested idea of a cultural continuum on the eastern shores of the North Sea region, crossing alleged political, ethnic, and territorial boundaries. This should prompt a discussion on the adequacy of our understanding of cultural interactions in connection with the Viking phenomenon.},
  file = {/Users/zackbatist/Library/CloudStorage/Dropbox/zotero/Croix and and IJssennagger - Van Der Pluijm   2021 - Cultures Without Borders Approaching the cultural continuum in the Danish–Frisian coastal areas in.pdf}
}

